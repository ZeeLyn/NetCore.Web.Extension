<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--<TargetFramework>netcoreapp3.1</TargetFramework>-->
		<TargetFrameworks>net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Authors>Owen</Authors>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/zeelyn/NetCore.Web.Extension</RepositoryUrl>
		<PackageProjectUrl>https://github.com/zeelyn/NetCore.Web.Extension</PackageProjectUrl>
		<Version>3.0.1</Version>
		<Description>NetCore.Web.Extension</Description>
		<PackageId>DotNetCore.Web.Extension</PackageId>
		<PackageTags>NetCore.Web.Extension</PackageTags>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)'== 'net7.0' ">
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="7.0.20" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)'== 'net8.0' ">
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.24" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)'== 'net9.0' ">
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.13" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)'== 'net10.0' ">
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.3" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>
</Project>
